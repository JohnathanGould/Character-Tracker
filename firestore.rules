rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can read (the GM view needs no account).
    // Only the player's account can write: her User UID from Authentication > Users,
    // which must match ownerUid in config.js.
    match /trackers/{characterId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == "bNp41HfYmMU2efGKCYmKGATCnE93"
        && request.resource.data.keys().hasOnly(["json", "updatedAt"])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
